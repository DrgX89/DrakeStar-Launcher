{
  "schemaVersion": 1,
  "id": "rust-addon",
  "version": "0.3.1",
  "name": "Addon nativo Rust",
  "description": "Ejemplo de mod nativo: cdylib compilado contra el ABI del intermediario.",
  "environment": "client",
  "entrypoints": {
    "main": ["drakestar_mod_entry"]
  },
  "depends": {
    "minecraft": "^26.2",
    "java": ">=25"
  },
  "custom": {
    "drakes": {
      "abi": "2",
      "hooks": {
        "main": ["mod:init", "client:tick"]
      }
    }
  }
}
