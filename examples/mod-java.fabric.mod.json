{
  "schemaVersion": 1,
  "id": "slimefun-drakes",
  "version": "2.1.0",
  "name": "Slimefun para Drakes",
  "description": "Ejemplo de mod Java real: classpath + JVM, verificado por manifiesto.",
  "environment": "*",
  "entrypoints": {
    "main": ["net.drakes.slimefun.SlimefunMod"],
    "server": ["net.drakes.slimefun.ServerHooks"]
  },
  "depends": {
    "minecraft": "^26.2",
    "fabricloader": ">=0.15",
    "java": ">=25"
  },
  "recommends": {
    "fabric-api": "*"
  },
  "breaks": {
    "old-slimefun": "<2.0.0"
  },
  "custom": {
    "drakes": {
      "hooks": {
        "main": ["mod:init"],
        "server": ["server:init", "server:command", "server:player_join"]
      }
    }
  }
}
