{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drakestar.dev/schemas/profile.v1.json",
  "title": "DrakeStar Profile v1",
  "type": "object",
  "required": ["schema", "id", "name", "mode", "channel", "minecraft"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,48}$" },
    "name": { "type": "string" },
    "mode": { "enum": ["drakes-rust", "drakes-java", "local-server", "online"] },
    "channel": { "enum": ["stable", "unstable", "nightly"] },
    "minecraft": { "type": "string" },
    "loader": { "enum": ["vanilla", "fabric", "forge", "neoforge"], "default": "vanilla" },
    "java": {
      "type": "object",
      "properties": {
        "major": { "type": ["integer", "null"] },
        "min_mem_mb": { "type": "integer", "minimum": 256, "default": 1024 },
        "max_mem_mb": { "type": "integer", "minimum": 256, "default": 4096 },
        "extra_jvm_args": { "type": "array", "items": { "type": "string" } }
      }
    },
    "server": { "type": ["string", "null"] },
    "preset": { "type": ["string", "null"] },
    "modpack": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  },
  "allOf": [
    { "if": { "properties": { "mode": { "const": "drakes-rust" } } }, "then": { "properties": { "loader": { "const": "vanilla" }, "modpack": { "type": "null" } } } },
    { "if": { "properties": { "mode": { "const": "online" } } }, "then": { "required": ["server"] } }
  ]
}
