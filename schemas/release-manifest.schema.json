{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drakestar.dev/schemas/manifest.v1.json",
  "title": "DrakeStar Release Manifest v1",
  "type": "object",
  "required": ["schema", "releases"],
  "properties": {
    "schema": { "const": 1 },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "channel", "minecraft", "artifacts"],
        "properties": {
          "version": { "type": "string" },
          "channel": { "enum": ["stable", "unstable", "nightly"] },
          "minecraft": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["component", "platform", "url", "sha256", "size"],
              "properties": {
                "component": { "enum": ["launcher", "drakes-rust-client", "drakespurpur", "drakes-natives"] },
                "platform": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
                "size": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
